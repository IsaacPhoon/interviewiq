# Note: DATABASE_URL must begin with 'postgresql+asyncpg://'.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/development_db

CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=<CLERK_WEBHOOK_SECRET>

# Note: AZURE_OPENAI_MODEL is the deployment name of the model in Microsoft Foundry.
AZURE_OPENAI_BASE_URL=https://<YOUR_RESOURCE_NAME>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=<AZURE_OPENAI_API_KEY>
AZURE_OPENAI_MODEL=gpt-4o

R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
R2_BUCKET_NAME=<R2_BUCKET_NAME>

AZURE_SPEECH_ENDPOINT=https://westus.api.cognitive.microsoft.com
AZURE_SPEECH_KEY=<AZURE_SPEECH_KEY>
AZURE_SPEECH_API_VERSION=2025-10-15
